# Database
DATABASE_URL=database_url
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=watchdog
REDIS_PASSWORD=redis_url

# Auth / JWT
SECRET_KEY=secret_key
COGNITO_REGION=region
COGNITO_USER_POOL_ID=pool_id
COGNITO_CLIENT_ID=client_id
TESTING=false
INTERNAL_API_TOKEN=abc4a6789a8cc7a89a00a099a876a54
MEDIAMTX_PUBLISH_MASTER_KEY=abc4a6789a8cc7a89a00a099a876a54

# Encryption
RTSP_ENCRYPTION_KEY=rtsp_encryption_key


# Cloud / Storage AWS 
AWS_REGION=region
AWS_ACCESS_KEY_ID=acess_id
AWS_SECRET_ACCESS_KEY=secret_access_key
S3_BUCKET_NAME=s3_bucket

# Frontend 
FRONTEND_URL=frontend_url

# Notifications
TWILIO_ACCOUNT_SID=twilio_account_sid
TWILIO_AUTH_TOKEN=twilio_auth_token
TWILIO_WHATSAPP_FROM=twilio_whatsapp_from_phone_numebr
NOTIFICATION_ENABLED=true
SMTP_SENDER_EMAIL=smtp_sender_email
SMTP_APP_PASSWORD=smtp_app_password

# Streaming (MediaMTX)
MEDIAMTX_RTSP_URL=rtsp_url
MTX_WEBRTCADDITIONALHOSTS=web_rtc_additional_hosts
MTX_WEBRTCALLOWORIGIN=web_rtc_allow_origin
MTX_AUTHHTTPADDRESS=auth_http_address
MTX_WEBRTCENCRYPTION=yes
MTX_WEBRTCSERVERCERT=/path/to/cert.pem
MTX_WEBRTCSERVERKEY=/path/to/cert.pem


# Stream failover controller
FAILOVER_CONTROLLER_TOKEN=replace-with-a-long-random-value
GO2RTC_API_USERNAME=watchdog-controller
GO2RTC_API_PASSWORD=replace-with-a-long-random-value
FAILOVER_POLL_SECONDS=5
FAILOVER_FAILURE_PROBES=3