# Application
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/watchdog

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=af-south-1
AWS_S3_BUCKET=your-bucket-name

# AWS Cognito
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=af-south-1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000


# Stream failover controller
FAILOVER_CONTROLLER_TOKEN=replace-with-a-long-random-value
GO2RTC_API_USERNAME=watchdog-controller
GO2RTC_API_PASSWORD=replace-with-a-long-random-value
FAILOVER_POLL_SECONDS=5
FAILOVER_FAILURE_PROBES=3